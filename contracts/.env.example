# Wallet that deploys and organises the election (also used by the web app relayer).
DEPLOYER_PRIVATE_KEY=
# Optional custom RPC; defaults to the public Base endpoints.
RPC_URL=
ELECTION_TITLE="Internship Coordinator Election 2026"
CANDIDATES="Candidate A,Candidate B"
# Optional: reuse an existing Semaphore deployment instead of deploying one.
SEMAPHORE_ADDRESS=
