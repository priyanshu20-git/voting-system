# --- Chain ---
# Base Sepolia by default. Use https://mainnet.base.org for Base mainnet.
RPC_URL=https://sepolia.base.org
# Address printed by `npm run deploy` in ../contracts
ELECTION_ADDRESS=
# Organiser wallet (same key that deployed the contract). It registers voters and pays gas for votes.
RELAYER_PRIVATE_KEY=

# --- Eligibility ---
# Recommended: the official voter roster from the election committee, one "enrollment,email" line per
# student. Students then sign up with their enrollment number and the link always goes to the email
# on the roster, so nobody can register in someone else's place by typing their number.
# Either paste the CSV here (lines separated by newlines or ";") or point VOTER_ROSTER_FILE at a file.
# Never commit the roster to git.
VOTER_ROSTER=
VOTER_ROSTER_FILE=
# Used only when no roster is set: comma-separated email domains allowed to register.
ALLOWED_EMAIL_DOMAINS=college.edu

# --- Sign-up emails ---
# Long random string, e.g. `openssl rand -hex 32`. Keep it secret and never change it mid-election.
AUTH_SECRET=
# Public URL of this site, used in sign-up links.
APP_URL=http://localhost:3000
# Resend (https://resend.com) API key and sender. Without a key, local dev prints the link on screen instead.
RESEND_API_KEY=
EMAIL_FROM="College Election <vote@yourdomain.com>"
